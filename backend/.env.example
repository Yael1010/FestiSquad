ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://app.example.com"]
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
DB_HOST=localhost
DB_PORT=1433
DB_NAME=FestiSquad
DB_USER=festisquad_app
DB_PASSWORD=replace-with-a-secure-secret
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=false
PERFORMANCE_TARGET_MS=1500
MAX_REQUEST_BODY_BYTES=1048576
